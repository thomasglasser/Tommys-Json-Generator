use ::java::util::particle::Particle
use ::java::util::block_state::BlockState
use ::java::data::advancement::predicate::BlockPredicate
use ::java::world::item::ItemStack
use ::java::data::advancement::predicate::ItemPredicate
use ::java::data::advancement::predicate::EntityPredicate
use ::java::util::text::TextColor
use ::java::world::item::SingleItem
use ::java::data::advancement::trigger::Conditions
use ::java::data::advancement::trigger::TriggerBase
use ::java::data::advancement::trigger::CompositeEntity
use ::java::data::util::NumberProvider
use ::java::data::tag::Tag

// ResourceKey: #[id="<registry>"] string
// HolderSet: (#[id(registry="<registry>",tags="allowed")] string | [#[id="<registry>"] string])

// Data Maps

type DataMap<K, V> = struct {
	replace?: boolean,
	values: struct DataMapValues {
		[K]: (
			V |
			struct ReplaceableValue {
				replace?: boolean,
				value: V,
			} |
		)
	},
	remove?: [K],
}

type LuckyCharms = (
    struct {
            loot_table: #[id="loot_table"] string,
    } |
    struct {
            items: (#[id(registry="item",tags="allowed")] string | [#[id="item"] string]),
    } |
)

dispatch minecraft:resource[mineraculous:data_map_kamikotization_lucky_charms] to DataMap<#[id(registry="mineraculous:kamikotization",tags="allowed")] string, (
	#[id="loot_table"] string |
	LuckyCharms
)>

dispatch minecraft:resource[mineraculous:data_map_miraculous_lucky_charms] to DataMap<#[id(registry="mineraculous:miraculous",tags="allowed")] string, (
	#[id="loot_table"] string |
	LuckyCharms
)>

dispatch minecraft:resource[mineraculous:data_map_entity_lucky_charms] to DataMap<#[id(registry="entity_type",tags="allowed")] string, (
	#[id="loot_table"] string |
	LuckyCharms
)>

type EffectAmplifier = (
	struct {
		amplifier: int @ 0..255,
	}
)

dispatch minecraft:resource[mineraculous:data_map_miraculous_effects] to DataMap<#[id(registry="mob_effect",tags="allowed")] string, (
    int @ 0..255 |
	EffectAmplifier
)>

enum(string) AttributeModifierOperation {
	AddValue = "add_value",
	AddMultipliedBase = "add_multiplied_base",
	AddMultipliedTotal = "add_multiplied_total",
}

type ModifierSettings = (
	struct {
		amount: double,  
		operation: AttributeModifierOperation,
	}
)

dispatch minecraft:resource[mineraculous:data_map_miraculous_attribute_modifiers] to DataMap<#[id(registry="attribute",tags="allowed")] string, (
    ModifierSettings
)>

type Ageable = (
	struct {
		next: #[id="block"] string,
	}
)

dispatch minecraft:resource[mineraculous:data_map_ageables] to DataMap<#[id(registry="block",tags="allowed")] string, (
	#[id="block"] string |
	Ageable
)>

// Abilities

dispatch minecraft:resource[mineraculous:ability] to struct Ability {
	type: #[id] AbilityType,
	...mineraculous:ability[[type]],
}

enum(string) AbilityType {
    ApplyEffectsOrDestroy = "mineraculous:apply_effects_or_destroy",
	AutomaticNightVision = "mineraculous:automatic_night_vision",
	ContextDependent = "mineraculous:context_dependent",
	Continuous = "mineraculous:continuous",
	ConvertAndTame = "mineraculous:convert_and_tame",
	PassiveEffects = "mineraculous:passive_effects",
	ReplaceAdjacentBlocks = "mineraculous:replace_adjacent_blocks",
	ReplaceItemInMainHand = "mineraculous:replace_item_in_main_hand",
	RevertLuckyCharmTargetsAbilityEffects = "mineraculous:revert_lucky_charm_targets_ability_effects",
	RightHandParticles = "mineraculous:right_hand_particles",
	SpectateEntity = "mineraculous:spectate_entity",
	SummonTargetDependentLuckyCharm = "mineraculous:summon_target_dependent_lucky_charm",
}

type EffectSettings = (
	struct {
		duration?: int @ -1..,
		ambient?: boolean,
		show_particles?: boolean,
		show_icon?: boolean,
	}
)

dispatch mineraculous:ability[mineraculous:apply_effects_or_destroy] to struct {
	effects: (#[id(registry="mob_effect",tags="allowed")] string | [#[id="mob_effect"] string]),
	effect_settings?: EffectSettings,
	damage_type?: #[id="damage_type"] string,
	override_kill_credit?: boolean,
	allow_blocking?: boolean,
	drop_item?: #[id="item"] string,
	apply_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:automatic_night_vision] to struct {
	light_level?: int @ 0..,
	shader?: string,
	apply_sound?: #[id="sound_event"] string,
	remove_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:context_dependent] to struct {
	block?: (Ability | #[id="mineraculous:ability"] string),
	entity?: (Ability | #[id="mineraculous:ability"] string),
	passive?: ([Ability] | #[id(registry="mineraculous:ability",tags="allowed")] string | [#[id="mineraculous:ability"] string]),
}

dispatch mineraculous:ability[mineraculous:continuous] to struct {
	ability: (Ability | #[id="mineraculous:ability"] string),
	ticks?: int @ 1..,
	passive_start_sound?: #[id="sound_event"] string,
	active_start_sound?: #[id="sound_event"] string,
	finish_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:convert_and_tame] to struct {
	new_type: #[id(registry="entity_type",tags="allowed")] string,
	valid_entities?: EntityPredicate,
	invalid_entities?: EntityPredicate,
	convert_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:passive_effects] to struct {
	effects: (#[id(registry="mob_effect",tags="allowed")] string | [#[id="mob_effect"] string]),
	start_amplifier?: int @ 0..,
}

dispatch mineraculous:ability[mineraculous:replace_adjacent_blocks] to struct {
	replacement?: BlockState,
	prefer_same?: boolean,
	valid_blocks?: BlockPredicate,
	invalid_blocks?: BlockPredicate,
	replace_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:replace_item_in_main_hand] to struct {
	replacement?: SingleItem,
	break_original?: boolean,
	valid_items?: ItemPredicate,
	invalid_items?: ItemPredicate,
	replace_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:revert_lucky_charm_targets_ability_effects] to struct {
	revert_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:right_hand_particles] to struct {
	particle: Particle,
}

dispatch mineraculous:ability[mineraculous:spectate_entity] to struct {
	valid_entities?: EntityPredicate,
	invalid_entities?: EntityPredicate,
	private_chat?: boolean,
	allow_remote_damage?: boolean,
	allow_kamikotization_revocation?: boolean,
	override_owner?: boolean,
	shader?: string,
	face_mask_texture?: string,
	start_sound?: #[id="sound_event"] string,
	stop_sound?: #[id="sound_event"] string,
}

dispatch mineraculous:ability[mineraculous:summon_target_dependent_lucky_charm] to struct {
	require_active_tool_in_hand?: boolean,
	summon_sound?: #[id="sound_event"] string,
}

// Kamikotization

dispatch minecraft:resource[mineraculous:kamikotization] to struct Kamikotization {
	default_name: string,
	item_predicate?: ItemPredicate,
	power_source: (ItemStack | Ability | #[id="mineraculous:ability"] string),
	passive_abilities?: (#[id(registry="mineraculous:ability",tags="allowed")] string | [#[id="mineraculous:ability"] string]),
}

// Miraculous

dispatch minecraft:resource[mineraculous:miraculous] to struct Miraculous {
	color: (
		#[color="hex_rgb"] string |
		#[color="named"] TextColor |
	),
	acceptable_slot: string,
	transformation_frames?: int @ 1..,
	tool?: SingleItem,
	tool_slot?: string,
	active_ability: (Ability | #[id="mineraculous:ability"] string),
	passive_abilities?: ([Ability] | [#[id="mineraculous:ability"] string]),
	transform_sound?: #[id="sound_event"] string,
	detransform_sound?: #[id="sound_event"] string,
	timer_beep_sound?: #[id="sound_event"] string,
	timer_end_sound?: #[id="sound_event"] string,
}

// Advancement Triggers

dispatch minecraft:trigger[mineraculous:transformed_miraculous] to Conditions<struct TransformedMiraculous {
	...TriggerBase,
	miraculous?: #[id="mineraculous:miraculous"] string,
}>

enum(string) BuiltInAbilityContext {
	Block = "block",
	Entity = "entity",
	LivingEntity = "living_entity",
}

type AbilityContext = (BuiltInAbilityContext | string)

dispatch minecraft:trigger[mineraculous:performed_miraculous_active_ability] to Conditions<struct PerformedMiraculousActiveAbility {
	...TriggerBase,
	miraculous?: #[id="mineraculous:miraculous"] string,
	contexts?: [AbilityContext],
}>

dispatch minecraft:trigger[mineraculous:kamikotized_entity] to Conditions<struct KamikotizedEntity {
	...TriggerBase,
	target?: CompositeEntity,
	kamikotization?: #[id="mineraculous:kamikotization"] string,
	self?: boolean,
}>

dispatch minecraft:trigger[mineraculous:released_purified_entities] to Conditions<struct ReleasedPurifiedEntities {
	...TriggerBase,
	released?: [CompositeEntity],
	count?: int @ 1..,
}>

dispatch minecraft:trigger[mineraculous:transformed_kamikotization] to Conditions<struct TransformedKamikotization {
	...TriggerBase,
	kamikotization?: #[id="mineraculous:kamikotization"] string,
	self?: boolean,
}>

dispatch minecraft:trigger[mineraculous:performed_kamikotization_active_ability] to Conditions<struct PerformedKamikotizationActiveAbility {
	...TriggerBase,
	kamikotization?: #[id="mineraculous:kamikotization"] string,
	contexts?: [AbilityContext],
}>

// Advancement Predicates

dispatch minecraft:entity_sub_predicate[mineraculous:kamikotization] to struct KamikotizationPredicate {
	kamikotizations?: (#[id(registry="mineraculous:kamikotization",tags="allowed")] string | [#[id="mineraculous:kamikotization"] string])
}

// Loot Conditions

dispatch minecraft:loot_condition[mineraculous:has_item] to struct HasItem {
	predicate: ItemPredicate,
	invert?: boolean,
}

// Number Providers

dispatch minecraft:number_provider[mineraculous:power_level_multiplier_generator] to struct PowerLevelMultiplierGenerator {
	base: NumberProvider,
}

// Data Components

type Unit = (struct {})

type UUID = (int[] @ 4)

dispatch minecraft:data_component[mineraculous:active] to boolean

type ActiveSettings = (
	struct {
		controller?: string,
		on_anim?: string,
		off_anim?: string,
		on_sound?: #[id="sound_event"] string,
		off_sound?: #[id="sound_event"] string,
	}
)

dispatch minecraft:data_component[mineraculous:active_settings] to ActiveSettings

dispatch minecraft:data_component[mineraculous:blocking] to Unit

dispatch minecraft:data_component[mineraculous:hide_enchantments] to Unit

dispatch minecraft:data_component[mineraculous:carrier] to int @ 0..

dispatch minecraft:data_component[mineraculous:owner] to UUID

dispatch minecraft:data_component[mineraculous:powered] to Unit

dispatch minecraft:data_component[mineraculous:charged] to boolean

dispatch minecraft:data_component[mineraculous:kwami_id] to UUID

dispatch minecraft:data_component[mineraculous:transformation_frames] to int @ 0..

dispatch minecraft:data_component[mineraculous:detransformation_frames] to int @ 0..

dispatch minecraft:data_component[mineraculous:remaining_ticks] to int @ 0..

dispatch minecraft:data_component[mineraculous:ladybug_yoyo_ability] to enum(string) {
	Block = "block",
	Lasso = "lasso",
	Phone = "phone",
	Purify = "purify",
	Spyglass = "spyglass",
	Travel = "travel"
}

dispatch minecraft:data_component[mineraculous:cat_staff_ability] to enum(string) {
	Block = "block",
	Perch = "perch",
	Phone = "phone",
	Spyglass = "spyglass",
	Throw = "throw",
	Travel = "travel"
}

dispatch minecraft:data_component[mineraculous:butterfly_cane_ability] to enum(string) {
	Blade = "blade",
	Block = "block",
	KamikoStore = "kamiko_store",
	Phone = "phone",
	Spyglass = "spyglass",
	Throw = "throw"
}

dispatch minecraft:data_component[mineraculous:lucky_charm] to struct LuckyCharm {
	target?: UUID,
	owner: UUID,
	id: int @ 0..,
}

dispatch minecraft:data_component[mineraculous:revertible_item_id] to UUID

dispatch minecraft:data_component[mineraculous:miraculous] to #[id="mineraculous:miraculous"] string

dispatch minecraft:data_component[mineraculous:miraculous_id] to UUID

dispatch minecraft:data_component[mineraculous:tool_id] to int @ 0..

dispatch minecraft:data_component[mineraculous:kamikotization] to #[id="mineraculous:kamikotization"] string

dispatch minecraft:data_component[mineraculous:kamiko_data] to struct KamikoData {
	uuid: UUID,
	owner: UUID,
	name_color: int @ 0..,
	face_mask_texture?: string,
}

// Tags

dispatch minecraft:resource[mineraculous:tag/ability] to Tag<#[id="mineraculous:ability"] string>
dispatch minecraft:resource[mineraculous:tag/miraculous] to Tag<#[id="mineraculous:miraculous"] string>
dispatch minecraft:resource[mineraculous:tag/kamikotization] to Tag<#[id="mineraculous:kamikotization"] string>
