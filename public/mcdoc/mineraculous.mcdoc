use ::java::util::particle::Particle
use ::java::util::block_state::BlockState
use ::java::data::advancement::predicate::BlockPredicate
use ::java::world::item::ItemStack
use ::java::assets::model::Predicates
use ::java::data::advancement::predicate::ItemPredicate
use ::java::data::advancement::predicate::EntityPredicate
use ::java::util::text::TextColor
use ::java::server::util::text::Text
use ::java::world::item::SingleItem
use ::java::data::advancement::trigger::Conditions as TriggerConditions
use ::java::data::advancement::trigger::TriggerBase
use ::java::data::advancement::trigger::CompositeEntity
use ::java::data::util::NumberProvider
use ::java::data::tag::Tag
use ::java::data::recipe::Smelting
use ::java::data::recipe::CookingBookCategory
use ::java::data::recipe::Ingredient
use ::java::data::loot::function::Conditions as LootConditions

// ResourceKey: #[id="<registry>"] string
// HolderSet: (#[misode_member_name="<registry> or Tag"] #[id(registry="<registry>", tags="allowed")] string | #[misode_member_name="<registry> List"] [#[id="<registry>"] string])
// Advancement Predicates
dispatch minecraft:entity_sub_predicate[mineraculous:kamikotization] to struct KamikotizationPredicate {
	kamikotizations?: (
		#[misode_member_name="Kamikotization or Tag"] #[id(registry="mineraculous:kamikotization", tags="allowed")] string |
		#[misode_member_name="Kamikotization List"] [#[id="mineraculous:kamikotization"] string] |
	),
}

dispatch minecraft:entity_sub_predicate[mineraculous:cat_staff] to struct CatStaffPredicate {
	traveling?: boolean,
	perching?: boolean,
}

dispatch minecraft:entity_sub_predicate[mineraculous:kamiko] to struct KamikoPredicate {
	is_replica?: boolean,
}

dispatch minecraft:data_component_predicate[mineraculous:active] to boolean

dispatch minecraft:data_component_predicate[mineraculous:lucky_charm] to struct ItemLuckyCharmPredicate {
	self?: boolean,
}

// Ability Sources
enum(string) AbilitySourceKeyRegistry {
	Miraculous = "mineraculous:miraculous",
	Kamikotization = "mineraculous:kamikotization",
}

dispatch mineraculous:ability_source_key[mineraculous:miraculous] to struct MiraculousAbilitySource {
	element: #[id="mineraculous:miraculous"] string,
}

dispatch mineraculous:ability_source_key[mineraculous:kamikotization] to struct KamikotizationAbilitySource {
	element: #[id="mineraculous:kamikotization"] string,
}

struct AbilitySourcePredicate {
	key?: struct RegistryDefinedResourceKey {
		registry: AbilitySourceKeyRegistry,
		...mineraculous:ability_source_key[[registry]],
	},
	minimum_power_level?: int,
	power_active?: boolean,
	has_stored_entities?: boolean,
	tool?: ItemPredicate,
}

// Ability Targets
struct AbilityTargetPredicate {
	type: #[id="mineraculous:ability_target_predicate"] string,
	...mineraculous:ability_target_predicate[[type]],
}

dispatch mineraculous:ability_target_predicate[mineraculous:block] to struct BlockAbilityTargetPredicate {
	block?: BlockPredicate,
}

dispatch mineraculous:ability_target_predicate[mineraculous:entity] to struct EntityAbilityTargetPredicate {
	entity?: EntityPredicate,
}

dispatch mineraculous:ability_target_predicate[mineraculous:passive] to struct PassiveAbilityTargetPredicate {}

// Advancement Triggers
dispatch minecraft:trigger[mineraculous:performed_ability] to TriggerConditions<struct PerformedAbility {
	...TriggerBase,
	id?: string,
	source?: AbilitySourcePredicate,
	target?: AbilityTargetPredicate,
}>

dispatch minecraft:trigger[mineraculous:transformed_miraculous] to TriggerConditions<struct TransformedMiraculous {
	...TriggerBase,
	miraculous?: #[id="mineraculous:miraculous"] string,
}>

dispatch minecraft:trigger[mineraculous:kamikotized_entity] to TriggerConditions<struct KamikotizedEntity {
	...TriggerBase,
	target?: CompositeEntity,
	kamikotization?: #[id="mineraculous:kamikotization"] string,
	self?: boolean,
}>

dispatch minecraft:trigger[mineraculous:released_purified_entities] to TriggerConditions<struct ReleasedPurifiedEntities {
	...TriggerBase,
	released?: [CompositeEntity],
	count?: int @ 1..,
}>

dispatch minecraft:trigger[mineraculous:transformed_kamikotization] to TriggerConditions<struct TransformedKamikotization {
	...TriggerBase,
	kamikotization?: #[id="mineraculous:kamikotization"] string,
	self?: boolean,
}>

// Data Components
struct Unit {}

type UUID = (int[] @ 4)

dispatch minecraft:data_component[mineraculous:active] to struct Active {
	active: boolean,
	show_in_tooltip?: boolean,
}

dispatch minecraft:data_component[mineraculous:blocking] to Unit

dispatch minecraft:data_component[mineraculous:hide_enchantments] to Unit

dispatch minecraft:data_component[mineraculous:carrier] to int @ 0..

dispatch minecraft:data_component[mineraculous:owner] to UUID

// Customization Setting Types
type ParticleCustomizationSettingType = Particle

type PositiveNumberCustomizationSettingType = int @ 1..

type ResourceLocationCustomizationSettingType = #[id] string

type SoundCustomizationSettingType = #[id="sound_event"] string

type StringCustomizationSettingType = string

dispatch mineraculous:customization_setting_type[mineraculous:particle] to struct ParticleCustomizationSetting {
	default_value?: ParticleCustomizationSettingType,
}

dispatch mineraculous:customization_setting_type[mineraculous:positive_number] to struct PositiveNumberCustomizationSetting {
	default_value?: PositiveNumberCustomizationSettingType,
}

dispatch mineraculous:customization_setting_type[mineraculous:resource_location] to struct ResourceLocationCustomizationSetting {
	default_value?: ResourceLocationCustomizationSettingType,
}

dispatch mineraculous:customization_setting_type[mineraculous:sound] to struct SoundCustomizationSetting {
	default_value?: SoundCustomizationSettingType,
}

dispatch mineraculous:customization_setting_type[mineraculous:string] to struct StringCustomizationSetting {
	default_value?: StringCustomizationSettingType,
}

struct UnbakedCustomizationSettings {
	[string]: struct UnbakedCustomizationSetting {
		type: #[id="mineraculous:customization_setting_type"] string,
		...mineraculous:customization_setting_type[[type]],
		optional?: boolean,
	},
}

// Built-In Customization Setting Keys
struct NameCustomizationSetting {
	"mineraculous:name"?: StringCustomizationSettingType,
}

struct TransformationFramesCustomizationSetting {
	"mineraculous:transformation_frames"?: PositiveNumberCustomizationSettingType,
}

struct TransformSoundCustomizationSetting {
	"mineraculous:transform_sound"?: SoundCustomizationSettingType,
}

struct DetransformSoundCustomizationSetting {
	"mineraculous:detransform_sound"?: SoundCustomizationSettingType,
}

struct TimerWarningSoundCustomizationSetting {
	"mineraculous:timer_warning_sound"?: SoundCustomizationSettingType,
}

struct TimerEndCustomizationSetting {
	"mineraculous:timer_end_sound"?: SoundCustomizationSettingType,
}

dispatch minecraft:data_component[mineraculous:customization_data] to struct CustomizationData {
	customization_settings: UnbakedCustomizationSettings,
	looks: struct LooksMap {
		[#[id="mineraculous:look_context"] string]: string,
	},
}

dispatch minecraft:data_component[mineraculous:powered] to Unit

dispatch minecraft:data_component[mineraculous:charged] to boolean

dispatch minecraft:data_component[mineraculous:kwami_id] to UUID

dispatch minecraft:data_component[mineraculous:transformation_state] to struct TransformationState {
	transforming: boolean,
	remaining_frames?: int,
	animate_suit: boolean,
}

dispatch minecraft:data_component[mineraculous:remaining_ticks] to int @ 0..

dispatch minecraft:data_component[mineraculous:power_state] to enum(string) PowerState {
	Hidden = "hidden",
	Active = "active",
	Powered_1 = "powered_1",
	Powered_2 = "powered_2",
	Powered_3 = "powered_3",
	Powered_4 = "powered_4",
	Powered = "powered",
}

dispatch minecraft:data_component[mineraculous:kwami_foods] to struct KwamiFoods {
	preferred_foods: #[id(registry="item", tags="required")] string,
	treats: #[id(registry="item", tags="required")] string,
	default_eat_ticks?: int @ 1..,
	is_left_handed?: boolean,
}

dispatch minecraft:data_component[mineraculous:eating_item] to struct EatingItem {
	item: SingleItem,
	remaining_ticks: int @ 0..,
}

dispatch minecraft:data_component[mineraculous:ladybug_yoyo_mode] to enum(string) LadybugYoyoMode {
	Block = "block",
	Lasso = "lasso",
	Phone = "phone",
	Purify = "purify",
	Spyglass = "spyglass",
	Travel = "travel",
}

dispatch minecraft:data_component[mineraculous:cat_staff_mode] to enum(string) CatStaffMode {
	Block = "block",
	Perch = "perch",
	Phone = "phone",
	Spyglass = "spyglass",
	Throw = "throw",
	Travel = "travel",
}

dispatch minecraft:data_component[mineraculous:butterfly_cane_mode] to enum(string) ButterflyCaneMode {
	Blade = "blade",
	Block = "block",
	KamikoStore = "kamiko_store",
	Phone = "phone",
	Spyglass = "spyglass",
	Throw = "throw",
}

dispatch minecraft:data_component[mineraculous:revertible_item_id] to UUID

dispatch minecraft:data_component[mineraculous:lucky_charm] to struct LuckyCharm {
	target?: UUID,
	owner: UUID,
	id: int @ 0..,
}

dispatch minecraft:data_component[mineraculous:miraculous] to #[id="mineraculous:miraculous"] string

dispatch minecraft:data_component[mineraculous:miraculous_id] to UUID

dispatch minecraft:data_component[mineraculous:tool_id] to int @ 0..

dispatch minecraft:data_component[mineraculous:kamikotization] to #[id="mineraculous:kamikotization"] string

dispatch minecraft:data_component[mineraculous:kamikotized] to boolean

// Looks
struct LookAssets {
	[(BuiltInLookAssetType | string)]: mineraculous:look_asset[[%key]],
}

enum(string) ModPredicates {
	Active = "mineraculous:active",
	MissingPieces = "mineraculous:missing_pieces",
	Mode = "mode",
	Thrown = "thrown",
	Storing = "storing",
}

struct ContextAssets {
	[#[id="mineraculous:look_context"] string]: (
		struct ItemLookAssets {
			#[misode_member_name="Full"] assets: LookAssets,
			overrides?: [struct LookOverride {
				predicate: struct LookOverridePredicates {
					[(Predicates | ModPredicates | string)]: float,
				},
				assets: LookAssets,
			}],
		} |
		#[misode_member_name="Assets"] LookAssets |
	),
}

dispatch minecraft:resource[mineraculous:look] to (
	struct Look {
		#[misode_member_name="Full"] parent?: #[id="mineraculous:look"] string,
		metadata?: struct LookMetadata {
			[#[id="mineraculous:look_metadata_type"] string]: mineraculous:look_metadata[[%key]],
		},
		contexts: ContextAssets,
	} |
	#[misode_member_name="Assets"] ContextAssets |
)

// Look Metadata
dispatch mineraculous:look_metadata[mineraculous:valid_miraculouses] to (
	[#[id="mineraculous:miraculous"] string] |
)

dispatch mineraculous:look_metadata[mineraculous:valid_kamikotizations] to (
	[#[id="mineraculous:kamikotization"] string] |
)

// Look Assets
enum(string) BuiltInLookAssetType {
	Texture = "mineraculous:texture",
	GeckolibModel = "mineraculous:geckolib_model",
	GeckolibAnimations = "mineraculous:geckolib_animations",
	ItemTransforms = "mineraculous:item_transforms",
	FlatTexture = "mineraculous:flat_texture",
	TransformationTextures = "mineraculous:transformation_textures",
	CountdownTextures = "mineraculous:countdown_textures",
	ScopeTexture = "mineraculous:scope_texture",
	CatStaffTextureLayout = "mineraculous:cat_staff_texture_layout",
}

dispatch mineraculous:look_asset[mineraculous:texture] to string

dispatch mineraculous:look_asset[mineraculous:geckolib_model] to string

dispatch mineraculous:look_asset[mineraculous:geckolib_animations] to string

dispatch mineraculous:look_asset[mineraculous:item_transforms] to string

dispatch mineraculous:look_asset[mineraculous:flat_texture] to string

dispatch mineraculous:look_asset[mineraculous:transformation_textures] to struct TransformationTextures {
	base: string,
	texture_count: int @ 1..,
}

dispatch mineraculous:look_asset[mineraculous:countdown_textures] to struct CountdownTextures {
	base: string,
}

dispatch mineraculous:look_asset[mineraculous:scope_texture] to string

struct UVRect {
	u1: int @ 0..,
	v1: int @ 0..,
	u2: int @ 0..,
	v2: int @ 0..,
}

dispatch mineraculous:look_asset[mineraculous:cat_staff_texture_layout] to struct CatStaffTextureLayout {
	texture_width?: int @ 1..,
	texture_height?: int @ 1..,
	staff_width_pixels?: int @ 1..,
	segment_height_pixels?: int @ 1..,
	glowing_line_height_pixels?: int @ 1..,
	segment_uv?: UVRect,
	paw_uv?: UVRect,
	line_uv?: UVRect,
	cap_uv?: UVRect,
}

// Registry Tags
dispatch minecraft:resource[mineraculous:tag/kamikotization] to Tag<#[id="mineraculous:kamikotization"] string>

dispatch minecraft:resource[mineraculous:tag/miraculous] to Tag<#[id="mineraculous:miraculous"] string>

// Data Maps
type DataMap<K, V> = struct {
	replace?: boolean,
	values: struct DataMapValues {
		[K]: (
			#[misode_member_name="Value"] V |
			struct ReplaceableValue {
				#[misode_member_name="Replaceable"] replace?: boolean,
				value: V,
			} |
		),
	},
	remove?: [K],
}

type LuckyCharms = struct {
	#[misode_member_name="Full Loot Table"] loot_table: #[id="loot_table"] string,
}

dispatch minecraft:resource[mineraculous:data_map_kamikotization_lucky_charms] to DataMap<#[id(registry="mineraculous:kamikotization", tags="allowed")] string, (
	#[misode_member_name="Loot Table"] #[id="loot_table"] string |
	#[misode_member_name="Full"] LuckyCharms |
)>

dispatch minecraft:resource[mineraculous:data_map_miraculous_lucky_charms] to DataMap<#[id(registry="mineraculous:miraculous", tags="allowed")] string, (
	#[misode_member_name="Loot Table"] #[id="loot_table"] string |
	#[misode_member_name="Full"] LuckyCharms |
)>

dispatch minecraft:resource[mineraculous:data_map_entity_lucky_charms] to DataMap<#[id(registry="entity_type", tags="allowed")] string, (
	#[misode_member_name="Loot Table"] #[id="loot_table"] string |
	#[misode_member_name="Full"] LuckyCharms |
)>

dispatch minecraft:resource[mineraculous:data_map_miraculous_effects] to DataMap<#[id(registry="mob_effect", tags="allowed")] string, (
	#[misode_member_name="Amplifier"] int @ 0..255 |
	struct MiraculousEffect {
		#[misode_member_name="Full"] amplifier: int @ 0..255,
		toggleable?: boolean,
	} |
)>

dispatch minecraft:resource[mineraculous:data_map_miraculous_attribute_modifiers] to DataMap<#[id(registry="attribute", tags="allowed")] string, (
	struct ModifierSettings {
		#[misode_member_name="Modifier Settings"] amount: double,
		operation: enum(string) Operation {
			AddValue = "add_value",
			AddMultipliedBase = "add_multiplied_base",
			AddMultipliedTotal = "add_multiplied_total",
		},
	} |
)>

dispatch minecraft:resource[mineraculous:data_map_ageables] to DataMap<#[id(registry="block", tags="allowed")] string, (
	#[misode_member_name="Block"] #[id="block"] string |
	struct Ageable {
		#[misode_member_name="Full"] next: #[id="block"] string,
	} |
)>

// Abilities
struct AbilityConditionInstance {
	type: #[id="mineraculous:ability_condition"] string,
	...mineraculous:ability_condition[[type]],
}

dispatch minecraft:resource[mineraculous:ability] to struct Ability {
	conditions?: [AbilityConditionInstance],
	branches: [struct AbilityBranch {
		conditions?: [AbilityConditionInstance],
		actions: [struct AbilityActionInstance {
			type: #[id="mineraculous:ability_action"] string,
			...mineraculous:ability_action[[type]],
		}],
	}],
	customization_settings?: UnbakedCustomizationSettings,
}

struct AbilityInstance {
	ability: #[id="mineraculous:ability"] string,
	continuous_ticks?: int,
	start_sound?: #[id="sound_event"] string,
	stop_sound?: #[id="sound_event"] string,
	customization_settings?: UnbakedCustomizationSettings,
}

// Ability Actions
struct EffectSettings {
	effect_duration?: int @ -1..,
	is_effect_ambient?: boolean,
	show_effect_particles?: boolean,
	show_effect_icon?: boolean,
}

dispatch mineraculous:ability_action[mineraculous:apply_effects_or_destroy] to struct ApplyEffectsOrDestroy {
	effects: (
		#[misode_member_name="Effect or Tag"] #[id(registry="mob_effect", tags="allowed")] string |
		#[misode_member_name="Effect List"] [#[id="mob_effect"] string] |
	),
	...EffectSettings,
	additive?: boolean,
	override_kill_credit?: boolean,
	allow_blocking?: boolean,
	drop_item?: SingleItem,
	apply_sound?: string,
}

dispatch mineraculous:ability_action[mineraculous:convert_and_tame] to struct ConvertAndTame {
	conversion: #[id="entity_type"] string,
	apply_sound?: string,
}

dispatch mineraculous:ability_action[mineraculous:passive_infinite_effects] to struct PassiveInfiniteEffects {
	effects: (
		#[misode_member_name="Effect or Tag"] #[id(registry="mob_effect", tags="allowed")] string |
		#[misode_member_name="Effect List"] [#[id="mob_effect"] string] |
	),
	...EffectSettings,
}

dispatch mineraculous:ability_action[mineraculous:replace_adjacent_blocks] to struct ReplaceAdjacentBlocks {
	replacement_block?: BlockState,
	instant?: boolean,
	prefer_same?: boolean,
	valid_blocks?: BlockPredicate,
	invalid_blocks?: BlockPredicate,
	apply_sound?: string,
}

dispatch mineraculous:ability_action[mineraculous:replace_item_in_main_hand] to struct ReplaceItemInMainHand {
	replacement_item?: SingleItem,
	break_original?: boolean,
	apply_sound?: string,
}

dispatch mineraculous:ability_action[mineraculous:revert_lucky_charm_targets_ability_effects] to struct RevertLuckyCharmTargetsAbilityEffects {
	revert_sound?: string,
}

dispatch mineraculous:ability_action[mineraculous:right_hand_particles] to struct RightHandParticles {
	particle: string,
}

dispatch mineraculous:ability_action[mineraculous:spectate_entity] to struct SpectateEntity {
	valid_entities?: EntityPredicate,
	invalid_entities?: EntityPredicate,
	can_private_chat?: boolean,
	can_hurt?: boolean,
	can_depower?: boolean,
	override_owner?: boolean,
	shader?: string,
	face_mask_texture?: string,
	start_sound?: string,
	stop_sound?: string,
}

dispatch mineraculous:ability_action[mineraculous:summon_target_dependent_lucky_charm] to struct SummonTargetDependentLuckyCharm {
	disappear_on_detransformation?: boolean,
	start_sound?: string,
}

dispatch mineraculous:ability_action[mineraculous:toggleable_special_effects] to struct ToggleableSpecialEffects {
	effects: (
		#[misode_member_name="Effect or Tag"] #[id(registry="mob_effect", tags="allowed")] string |
		#[misode_member_name="Effect List"] [#[id="mob_effect"] string] |
	),
	...EffectSettings,
	shader?: string,
	apply_sound?: string,
	remove_sound?: string,
}

// Ability Conditions
struct EntityCondition {
	valid_entities?: EntityPredicate,
	invalid_entities?: EntityPredicate,
}

dispatch mineraculous:ability_condition[mineraculous:performer] to EntityCondition

dispatch mineraculous:ability_condition[mineraculous:source] to struct SourceCondition {
	valid_ability_sources?: AbilitySourcePredicate,
	invalid_ability_sources?: AbilitySourcePredicate,
}

dispatch mineraculous:ability_condition[mineraculous:target] to struct TargetCondition {
	valid_ability_targets?: AbilityTargetPredicate,
	invalid_ability_targets?: AbilityTargetPredicate,
}

// Recipe Serializers
dispatch minecraft:recipe_serializer[mineraculous:oven_cooking] to Smelting

dispatch minecraft:recipe_serializer[
	mineraculous:smelting_transmute,
	mineraculous:smoking_transmute,
	mineraculous:campfire_cooking_transmute,
	mineraculous:oven_cooking_transmute,
] to struct TransmuteSmelting {
	group?: string,
	category?: CookingBookCategory,
	ingredient: Ingredient,
	result: #[id(registry="item", exclude=["air"])] string,
	experience?: float,
	cookingtime?: int,
}

// Loot Functions
dispatch minecraft:loot_function[mineraculous:dye_randomly] <F, C>to struct DyeRandomly {
	color_count?: NumberProvider,
	...LootConditions<C>,
}

dispatch minecraft:loot_function[mineraculous:set_miraculous_randomly] <F, C>to struct SetMiraculousRandomly {
	...LootConditions<C>,
}

// Loot Conditions
dispatch minecraft:loot_condition[mineraculous:has_item] to struct HasItem {
	predicate: ItemPredicate,
	invert?: boolean,
}

// Number Providers
dispatch minecraft:number_provider[mineraculous:power_level_multiplier] to struct PowerLevelMultiplier {
	base: NumberProvider,
	divisor?: int,
}

// Structure Processor Types
dispatch minecraft:template_processor[mineraculous:framed_item_dye] to struct FramedItemDye {
	valid_items?: ItemPredicate,
	invalid_items?: ItemPredicate,
	color_count?: NumberProvider,
}

// Kamikotization Conditions
dispatch mineraculous:kamikotization_condition[mineraculous:giver] to struct GiverKamikotizationCondition {
	predicate: EntityPredicate,
	message: Text,
}

dispatch mineraculous:kamikotization_condition[mineraculous:receiver] to struct ReceiverKamikotizationCondition {
	predicate: EntityPredicate,
	message: Text,
}

dispatch mineraculous:kamikotization_condition[mineraculous:item] to struct ItemKamikotizationCondition {
	predicate: ItemPredicate,
	message?: Text,
}

dispatch mineraculous:kamikotization_condition[mineraculous:minimum_power_level] to struct MinimumPowerLevelKamikotizationCondition {
	level: int @ 0..,
}

// Kamikotization
dispatch minecraft:resource[mineraculous:kamikotization] to struct Kamikotization {
	conditions?: [struct KamikotizationCondition {
		type: #[id="mineraculous:kamikotization_condition"] string,
		...mineraculous:kamikotization_condition[[type]],
	}],
	customization_settings?: struct KamikotizationCustomizationSettings {
		...NameCustomizationSetting,
		[#[id] string]: any,
	},
	power_source: (
		#[misode_member_name="Item"] ItemStack |
		#[misode_member_name="Ability"] AbilityInstance |
	),
	passive_abilities?: [AbilityInstance],
}

// Miraculous
dispatch minecraft:resource[mineraculous:miraculous] to struct Miraculous {
	color: (
		#[misode_member_name="RGB Hex"] #[color="hex_rgb"] string |
		#[misode_member_name="Built-In"] #[color="named"] TextColor |
	),
	acceptable_slot: string,
	tool: SingleItem,
	tool_slot?: string,
	customization_settings?: struct MiraculousCustomizationSettings {
		...NameCustomizationSetting,
		...TransformationFramesCustomizationSetting,
		...TransformSoundCustomizationSetting,
		...DetransformSoundCustomizationSetting,
		...TimerWarningSoundCustomizationSetting,
		...TimerEndCustomizationSetting,
		[#[id] string]: any,
	},
	active_ability: AbilityInstance,
	passive_abilities?: [AbilityInstance],
}
